# .env is read by `docker compose` for ${...} interpolation only.
# The backend itself does not load .env in dev — export vars or prefix commands.
# qBittorrent WebUI URL (internal docker DNS in compose, localhost for dev)
QB_URL=http://qbittorrent:8080
PORT=8081
HOST=0.0.0.0
# REQUIRED. Generate one, e.g.: openssl rand -hex 32
# The public placeholder (change-me-to-32-random-chars) refuses to boot.
SESSION_SECRET=
LOG_LEVEL=info
# Only set true when Veneer sits behind a real reverse proxy (nginx/Traefik/Caddy)
# that sets X-Forwarded-For. When true behind no proxy, clients can spoof the
# login rate-limit key via that header.
TRUST_PROXY=false
COOKIE_SECURE=false
# Browser-facing URL when a proxy rewrites Host (login CSRF allowlist), e.g.
# https://veneer.example.com
PUBLIC_ORIGIN=
# Veneer session cookie name + TTL
VENEER_COOKIE=veneer_sid
SESSION_TTL_HOURS=24
# Seed-rule store + auto-enforce cadence in minutes (0 disables the ticker)
RULES_FILE=./data/rules.json
RULES_INTERVAL_MIN=5
